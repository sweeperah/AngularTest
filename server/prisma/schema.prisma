// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Product {
  id          String  @id
  name        String
  category    String
  price       Float
  rating      Int
  imageSeed   String
  isDirectPay Boolean @default(false)
}
